---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getAllDevices, getDeviceBySlug, getRelatedDevices } from '../../../services/deviceService';
import { getBrandById } from '../../../services/brandService';
import DeviceCard from '../../../components/cards/DeviceCard';

export async function getStaticPaths() {
  const devices = getAllDevices();
  return devices.map(d => ({ params: { slug: d.slug } }));
}

const { slug } = Astro.params;
const BASE = '/thpedianv26.lv';
const device = getDeviceBySlug(slug!)!;
if (!device) return Astro.redirect(`${BASE}/hi/devices/`);

const brand = getBrandById(device.brand);
const related = getRelatedDevices(device, 4);
const primaryImage = device.images?.[0];

function renderSpecs(specs: Record<string, unknown>, depth = 0): { key: string; label: string; value: string; group: string }[] {
  const rows: { key: string; label: string; value: string; group: string }[] = [];
  for (const [k, v] of Object.entries(specs ?? {})) {
    if (v === null || v === undefined) continue;
    if (typeof v === 'object' && !Array.isArray(v)) {
      const nested = renderSpecs(v as Record<string, unknown>, depth + 1);
      nested.forEach(r => rows.push({ ...r, group: depth === 0 ? k : r.group }));
    } else {
      const label = k.replace(/([A-Z])/g, ' $1').replace(/^\w/, c => c.toUpperCase()).trim();
      const value = Array.isArray(v) ? v.join(', ') : String(v);
      rows.push({ key: k, label, value, group: depth === 0 ? k : '' });
    }
  }
  return rows;
}

const specRows = renderSpecs(device.specs as Record<string, unknown>);
const groups: Record<string, { key: string; label: string; value: string }[]> = {};
let currentGroup = 'General';
for (const row of specRows) {
  if (row.group) currentGroup = row.group;
  const gLabel = currentGroup.replace(/([A-Z])/g, ' $1').replace(/^\w/, c => c.toUpperCase()).trim();
  if (!groups[gLabel]) groups[gLabel] = [];
  if (row.key !== currentGroup) groups[gLabel].push({ key: row.key, label: row.label, value: row.value });
}

const verificationBadge = {
  official: { label: 'आधिकारिक स्रोत', cls: 'tp-badge-green' },
  'multiple-sources': { label: 'एकाधिक स्रोत', cls: 'tp-badge-blue' },
  secondary: { label: 'द्वितीयक स्रोत', cls: 'tp-badge-amber' },
  unverified: { label: 'असत्यापित', cls: 'bg-slate-800/40 text-slate-400 border-slate-600/30 tp-badge' },
};
const vb = verificationBadge[device.verificationLevel] ?? verificationBadge.unverified;
---

<BaseLayout
  title={`${device.name} — तकनीकी विशिष्टताएँ — Techpedia`}
  description={device.description}
  lang="hi"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-10">
    <nav class="flex items-center gap-2 text-sm text-slate-400 mb-6">
      <a href={`${BASE}/hi/`} class="hover:text-slate-200">होम</a>
      <span>/</span>
      <a href={`${BASE}/hi/devices/`} class="hover:text-slate-200">डिवाइस</a>
      <span>/</span>
      <span class="text-slate-200">{device.name}</span>
      <span class="ml-auto text-xs text-slate-500">
        <a href={`${BASE}/en/devices/${device.slug}/`} class="hover:text-slate-300">English ↗</a>
      </span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Left column -->
      <div class="lg:col-span-1">
        <div class="sticky top-6">
          {primaryImage ? (
            <div class="rounded-xl bg-navy-800/40 border border-tp-border p-4 mb-4 flex items-center justify-center min-h-[220px]">
              <img
                src={primaryImage.url}
                alt={primaryImage.alt}
                class="max-h-56 w-auto object-contain"
                loading="lazy"
              />
            </div>
          ) : (
            <div class="rounded-xl bg-navy-800/40 border border-tp-border p-8 mb-4 flex items-center justify-center min-h-[220px]">
              <span class="text-6xl opacity-30">📱</span>
            </div>
          )}

          <div class="rounded-xl bg-navy-800/40 border border-tp-border p-4 mb-4 space-y-3 text-sm">
            <div class="flex justify-between">
              <span class="text-slate-400">श्रेणी</span>
              <span class="text-slate-200 capitalize">{device.category}</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-400">वर्ष</span>
              <span class="text-slate-200">{device.releasedAt?.slice(0,4) ?? '—'}</span>
            </div>
            {brand && (
              <div class="flex justify-between">
                <span class="text-slate-400">ब्रांड</span>
                <a href={`${BASE}/hi/brands/${brand.slug}/`} class="text-tp-blue hover:underline">{brand.name}</a>
              </div>
            )}
            <div class="flex justify-between items-center">
              <span class="text-slate-400">सत्यापन</span>
              <span class={`${vb.cls} text-xs`}>{vb.label}</span>
            </div>
          </div>

          <a
            href={`${BASE}/en/compare/?ids=${device.id}`}
            class="tp-btn-secondary w-full text-center block"
          >
            तुलना करें →
          </a>
        </div>
      </div>

      <!-- Right column -->
      <div class="lg:col-span-2">
        <div class="mb-2">
          {brand && <a href={`${BASE}/hi/brands/${brand.slug}/`} class="text-sm text-tp-blue hover:underline">{brand.name}</a>}
        </div>
        <h1 class="text-2xl sm:text-3xl font-bold text-slate-100 mb-3">{device.name}</h1>
        <p class="text-slate-400 mb-6 leading-relaxed">{device.description}</p>

        {device.keyFeatures && device.keyFeatures.length > 0 && (
          <div class="mb-8">
            <h2 class="text-lg font-semibold text-slate-100 mb-3">मुख्य विशेषताएँ</h2>
            <div class="flex flex-wrap gap-2">
              {device.keyFeatures.map(f => <span class="tp-badge-blue">{f}</span>)}
            </div>
          </div>
        )}

        <div class="mb-8">
          <h2 class="text-lg font-semibold text-slate-100 mb-4">तकनीकी विशिष्टताएँ</h2>
          {Object.entries(groups).map(([groupName, rows]) => (
            <div class="mb-5">
              <h3 class="text-sm font-semibold text-tp-blue uppercase tracking-wide mb-2">{groupName}</h3>
              <div class="rounded-xl overflow-hidden border border-tp-border">
                {rows.map((row, i) => (
                  <div class={`spec-row ${i % 2 === 0 ? 'bg-navy-800/30' : 'bg-navy-800/10'}`}>
                    <span class="spec-label">{row.label}</span>
                    <span class="spec-value">{row.value}</span>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>

        {device.tags && device.tags.length > 0 && (
          <div class="mb-6">
            <h2 class="text-sm font-semibold text-slate-400 uppercase tracking-wide mb-2">टैग</h2>
            <div class="flex flex-wrap gap-2">
              {device.tags.map(t => <span class="tp-badge text-xs bg-navy-700/60 text-slate-400 border-slate-600/20">{t}</span>)}
            </div>
          </div>
        )}
      </div>
    </div>

    {related.length > 0 && (
      <div class="mt-12 pt-8 border-t border-tp-border">
        <h2 class="text-xl font-bold text-slate-100 mb-6">संबंधित डिवाइस</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
          {related.map(d => <DeviceCard device={d} lang="hi" client:visible />)}
        </div>
      </div>
    )}
  </div>
</BaseLayout>
