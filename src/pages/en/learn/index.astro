---
import BaseLayout from '../../../layouts/BaseLayout.astro';
const BASE = '/thpedianv26.lv';

const guides = [
  { slug: 'what-is-a-cpu', title: 'What is a CPU?', level: 'beginner', icon: '⚙️', readTime: '8 min', summary: 'Understand how modern processors work — cores, threads, cache and instruction pipelines.' },
  { slug: 'how-does-ram-work', title: 'How Does RAM Work?', level: 'beginner', icon: '💾', readTime: '7 min', summary: 'From DRAM cells to DDR5 — memory types, timing, channels and latency explained.' },
  { slug: 'gpu-architecture-basics', title: 'GPU Architecture Basics', level: 'intermediate', icon: '🎮', readTime: '10 min', summary: 'Shader processors, VRAM, rasterization, ray tracing and AI acceleration.' },
  { slug: 'understanding-transistors', title: 'Understanding Transistors', level: 'beginner', icon: '🔌', readTime: '6 min', summary: 'The fundamental building block of all digital electronics. BJT, MOSFET and beyond.' },
  { slug: 'ohms-law-and-circuit-basics', title: "Ohm's Law and Circuit Basics", level: 'beginner', icon: '⚡', readTime: '6 min', summary: 'Voltage, current, resistance and how they relate in simple and complex circuits.' },
  { slug: 'ssd-vs-hdd', title: 'SSD vs HDD Technology', level: 'beginner', icon: '💿', readTime: '7 min', summary: 'NAND flash, wear leveling, NVMe protocol and why SSDs outperform spinning drives.' },
  { slug: 'wifi-7-explained', title: 'Wi-Fi 7 Explained', level: 'intermediate', icon: '📶', readTime: '8 min', summary: 'Multi-Link Operation, 320 MHz channels, QAM-4096 and what makes Wi-Fi 7 different.' },
  { slug: 'introduction-to-microcontrollers', title: 'Introduction to Microcontrollers', level: 'beginner', icon: '🔧', readTime: '8 min', summary: 'What microcontrollers are, how to choose one and common peripherals like GPIO, SPI, I2C.' },
];

const levelColors: Record<string, string> = {
  beginner: 'tp-badge-green',
  intermediate: 'tp-badge-blue',
  advanced: 'tp-badge-violet',
  professional: 'bg-slate-800/60 text-slate-300 border-slate-600/30 tp-badge',
};
---

<BaseLayout
  title="Learning Centre — Techpedia"
  description="Technology guides, tutorials and explainers. Beginner to advanced electronics, computing and hardware topics."
  lang="en"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-10">
    <nav class="flex items-center gap-2 text-sm text-slate-400 mb-6">
      <a href={`${BASE}/en/`} class="hover:text-slate-200">Home</a>
      <span>/</span>
      <span class="text-slate-200">Learn</span>
    </nav>

    <div class="mb-10">
      <h1 class="text-3xl font-bold text-slate-100 mb-2">Learning Centre</h1>
      <p class="text-slate-400">Structured guides and tutorials from beginner to professional level</p>
    </div>

    <div class="flex flex-wrap gap-2 mb-8">
      {['All', 'Beginner', 'Intermediate', 'Advanced'].map(level => (
        <button class={`text-sm px-3 py-1.5 rounded-lg border transition-colors ${level === 'All' ? 'bg-tp-blue text-white border-tp-blue' : 'bg-navy-800 text-slate-400 border-tp-border hover:border-slate-500 hover:text-slate-200'}`}>
          {level}
        </button>
      ))}
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {guides.map(guide => (
        <a href={`${BASE}/en/learn/${guide.slug}/`} class="tp-card p-5 flex flex-col gap-3 hover:border-tp-blue/50 transition-colors">
          <div class="flex items-start gap-3">
            <div class="w-9 h-9 rounded-lg bg-navy-700 flex items-center justify-center text-xl flex-shrink-0">{guide.icon}</div>
            <div class="min-w-0">
              <h3 class="font-semibold text-slate-100 leading-tight">{guide.title}</h3>
              <div class="flex items-center gap-2 mt-1">
                <span class={`text-xs ${levelColors[guide.level] ?? levelColors.beginner}`}>{guide.level}</span>
                <span class="text-xs text-slate-500">· {guide.readTime}</span>
              </div>
            </div>
          </div>
          <p class="text-sm text-slate-400 line-clamp-3">{guide.summary}</p>
          <div class="mt-auto">
            <span class="text-xs text-tp-blue font-medium">Read article →</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
