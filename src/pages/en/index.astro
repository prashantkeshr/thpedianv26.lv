---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SearchBar from '../../components/search/SearchBar';
import DeviceCard from '../../components/cards/DeviceCard';
import ComponentCard from '../../components/cards/ComponentCard';
import { getAllDevices } from '../../services/deviceService';
import { getAllComponents } from '../../services/componentService';
import { getAllBrands } from '../../services/brandService';

const devices = getAllDevices();
const components = getAllComponents();
const brands = getAllBrands();
const BASE = '';

const featuredDevices = devices.slice(0, 4);
const featuredComponents = components.slice(0, 4);
const featuredBrands = brands.slice(0, 6);

const categories = [
  { name: 'Smartphones', icon: '📱', slug: 'smartphone', count: devices.filter(d => d.category === 'smartphone').length },
  { name: 'Laptops', icon: '💻', slug: 'laptop', count: devices.filter(d => d.category === 'laptop').length },
  { name: 'CPUs', icon: '⚙️', slug: 'cpu', count: components.filter(c => c.category === 'cpu').length },
  { name: 'GPUs', icon: '🎮', slug: 'gpu', count: components.filter(c => c.category === 'gpu').length },
  { name: 'Microcontrollers', icon: '🔧', slug: 'microcontroller', count: components.filter(c => c.category === 'microcontroller').length },
  { name: 'Monitors', icon: '🖥️', slug: 'monitor', count: devices.filter(d => d.category === 'monitor').length },
  { name: 'Storage', icon: '💾', slug: 'storage', count: devices.filter(d => d.category === 'storage').length },
  { name: 'All Components', icon: '🔌', slug: null, count: components.length },
];
---

<BaseLayout
  title="Techpedia — Explore Technology. Understand Every Device."
  description="Techpedia is a global technology encyclopedia. Search devices, components, brands, technologies, tutorials and troubleshooting guides."
  lang="en"
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-gradient-to-b from-navy-950 via-navy-900 to-navy-900 pb-16 pt-20">
    <!-- Background grid pattern -->
    <div class="absolute inset-0 bg-grid-pattern opacity-30 pointer-events-none" />

    <!-- Accent glow -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[300px] bg-tp-blue/8 blur-[120px] rounded-full pointer-events-none" />

    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 text-center">
      <!-- Label -->
      <div class="inline-flex items-center gap-2 tp-badge-cyan mb-6 px-3 py-1.5 text-sm">
        <span class="w-2 h-2 rounded-full bg-tp-cyan animate-pulse-slow" />
        Global Technology Encyclopedia
      </div>

      <!-- Headline -->
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-slate-100 leading-tight mb-5">
        Explore Technology.<br />
        <span class="gradient-text">Understand Every Device.</span>
      </h1>

      <p class="text-lg text-slate-400 max-w-2xl mx-auto mb-10 leading-relaxed">
        Search {devices.length} devices, {components.length} components, {brands.length} brands and growing.
        Technical specifications, comparisons, datasheets and learning resources.
      </p>

      <!-- Search bar -->
      <div class="max-w-3xl mx-auto">
        <SearchBar lang="en" variant="hero" client:load />
      </div>

      <!-- Popular searches -->
      <div class="mt-6 flex flex-wrap items-center justify-center gap-2">
        <span class="text-sm text-slate-500">Popular:</span>
        {['iPhone 16 Pro', 'RTX 4090', 'Ryzen 9 9950X', 'Galaxy S25 Ultra'].map(term => (
          <a
            href={`${BASE}/en/search/?q=${encodeURIComponent(term)}`}
            class="text-sm text-slate-400 hover:text-tp-cyan transition-colors px-2 py-0.5 rounded bg-navy-800 border border-tp-border hover:border-tp-cyan"
          >
            {term}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Stats bar -->
  <section class="bg-navy-800/60 border-y border-tp-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-4">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-center">
        {[
          { label: 'Devices', value: devices.length, icon: '📱' },
          { label: 'Components', value: components.length, icon: '🔌' },
          { label: 'Brands', value: brands.length, icon: '🏢' },
          { label: 'Languages', value: 2, icon: '🌐' },
        ].map(({ label, value, icon }) => (
          <div class="flex items-center justify-center gap-2">
            <span class="text-xl">{icon}</span>
            <div>
              <div class="text-xl font-bold text-slate-100">{value.toLocaleString()}</div>
              <div class="text-xs text-slate-400">{label}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Categories -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-16">
    <div class="flex items-end justify-between mb-8">
      <div>
        <h2 class="tp-section-title">Technology Categories</h2>
        <p class="tp-section-subtitle">Browse by device or component type</p>
      </div>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
      {categories.map(({ name, icon, slug, count }) => (
        <a
          href={slug ? `${BASE}/en/devices/?category=${slug}` : `${BASE}/en/components/`}
          class="tp-card p-4 flex items-center gap-3 group"
        >
          <span class="text-2xl">{icon}</span>
          <div class="min-w-0">
            <div class="text-sm font-medium text-slate-100 group-hover:text-tp-cyan transition-colors truncate">{name}</div>
            <div class="text-xs text-slate-500">{count} items</div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Featured Devices -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 pb-16">
    <div class="flex items-end justify-between mb-8">
      <div>
        <h2 class="tp-section-title">Featured Devices</h2>
        <p class="tp-section-subtitle">Latest and most referenced devices</p>
      </div>
      <a href={`${BASE}/en/devices/`} class="tp-btn-ghost text-sm">
        View all →
      </a>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {featuredDevices.map(device => (
        <DeviceCard device={device} lang="en" client:visible />
      ))}
    </div>
  </section>

  <!-- Featured Components -->
  <section class="bg-navy-800/30 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="flex items-end justify-between mb-8">
        <div>
          <h2 class="tp-section-title">Component Encyclopedia</h2>
          <p class="tp-section-subtitle">CPUs, GPUs, microcontrollers and electronic components</p>
        </div>
        <a href={`${BASE}/en/components/`} class="tp-btn-ghost text-sm">
          View all →
        </a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {featuredComponents.map(comp => (
          <ComponentCard component={comp} lang="en" client:visible />
        ))}
      </div>
    </div>
  </section>

  <!-- Compare CTA -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-16">
    <div class="relative rounded-2xl bg-gradient-to-br from-navy-700 to-navy-800 border border-tp-border overflow-hidden p-8 sm:p-12">
      <div class="absolute right-0 top-0 w-64 h-64 bg-tp-blue/10 blur-3xl rounded-full pointer-events-none" />
      <div class="relative max-w-2xl">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-100 mb-3">
          Compare Devices & Components
        </h2>
        <p class="text-slate-400 mb-6 leading-relaxed">
          Side-by-side specification comparison with difference highlighting, shareable URLs,
          and category-specific intelligent spec grouping.
        </p>
        <a href={`${BASE}/en/compare/`} class="tp-btn-primary">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2"/>
          </svg>
          Start Comparing
        </a>
      </div>
    </div>
  </section>

  <!-- Brand Directory preview -->
  <section class="bg-navy-800/30 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="flex items-end justify-between mb-8">
        <div>
          <h2 class="tp-section-title">Brand Directory</h2>
          <p class="tp-section-subtitle">Manufacturers and technology companies</p>
        </div>
        <a href={`${BASE}/en/brands/`} class="tp-btn-ghost text-sm">View all →</a>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
        {featuredBrands.map(brand => (
          <a
            href={`${BASE}/en/brands/${brand.slug}/`}
            class="tp-card p-4 flex flex-col items-center text-center group"
          >
            <div class="w-12 h-12 rounded-full bg-navy-700 flex items-center justify-center mb-2 text-xl">
              🏢
            </div>
            <div class="text-sm font-medium text-slate-200 group-hover:text-tp-cyan transition-colors">
              {brand.name}
            </div>
            <div class="text-xs text-slate-500 mt-0.5">{brand.productCategories[0]}</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Learn + Troubleshoot -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-16">
    <div class="grid sm:grid-cols-2 gap-6">
      <!-- Learning Centre -->
      <div class="tp-card p-6">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 rounded-lg bg-violet-900/40 border border-violet-700/30 flex items-center justify-center text-xl">
            📚
          </div>
          <div>
            <h3 class="font-semibold text-slate-100">Learning Centre</h3>
            <p class="text-xs text-slate-400">Guides, tutorials and explainers</p>
          </div>
        </div>
        <p class="text-sm text-slate-400 mb-4">
          From beginner electronics to advanced semiconductor topics. Structured learning paths
          for every knowledge level.
        </p>
        <a href={`${BASE}/en/learn/`} class="tp-btn-secondary text-sm">
          Explore Guides
        </a>
      </div>

      <!-- Troubleshoot -->
      <div class="tp-card p-6">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 rounded-lg bg-amber-900/40 border border-amber-700/30 flex items-center justify-center text-xl">
            🔧
          </div>
          <div>
            <h3 class="font-semibold text-slate-100">Troubleshooting</h3>
            <p class="text-xs text-slate-400">Interactive diagnostic guides</p>
          </div>
        </div>
        <p class="text-sm text-slate-400 mb-4">
          Step-by-step troubleshooting for smartphones, laptops, desktops, circuits and components.
          Interactive decision trees.
        </p>
        <a href={`${BASE}/en/troubleshoot/`} class="tp-btn-secondary text-sm">
          Troubleshoot Now
        </a>
      </div>
    </div>
  </section>

  <!-- Data quality notice -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 pb-16">
    <div class="rounded-xl bg-navy-800/40 border border-tp-border p-5 flex items-start gap-4">
      <div class="text-2xl flex-shrink-0">🛡️</div>
      <div>
        <h4 class="text-sm font-semibold text-slate-200 mb-1">Verified, Sourced Data</h4>
        <p class="text-xs text-slate-400 leading-relaxed">
          All technical specifications on Techpedia include source references and verification status.
          Data comes from official manufacturer documentation, datasheets and reliable technical sources.
          Unverified or uncertain values are clearly labeled.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
