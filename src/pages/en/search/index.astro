---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SearchBar from '../../../components/search/SearchBar';

const BASE = '';
const q = Astro.url.searchParams.get('q') ?? '';
---

<BaseLayout
  title={q ? `Search: ${q} — Techpedia` : 'Search — Techpedia'}
  description="Search Techpedia for devices, components, brands and technologies."
  lang="en"
  noindex={!q}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-10">
    <nav class="flex items-center gap-2 text-sm text-slate-400 mb-6">
      <a href={`${BASE}/en/`} class="hover:text-slate-200">Home</a>
      <span>/</span>
      <span class="text-slate-200">Search</span>
    </nav>

    <h1 class="text-2xl font-bold text-slate-100 mb-6">
      {q ? `Results for "${q}"` : 'Search Techpedia'}
    </h1>

    <div class="mb-8">
      <SearchBar lang="en" variant="hero" autoFocus={!q} client:load />
    </div>

    <!-- Results are loaded client-side by the SearchResultsClient component -->
    <div id="search-results-container">
      {!q && (
        <div class="text-center py-16 text-slate-400">
          <div class="text-5xl mb-4">🔍</div>
          <p class="text-lg font-medium text-slate-300">What are you looking for?</p>
          <p class="text-sm mt-2 mb-8">Search devices, components, brands, technologies and more.</p>
          <div class="flex flex-wrap gap-2 justify-center">
            {['iPhone 16 Pro', 'RTX 4090', 'Ryzen 9 9950X', 'Snapdragon 8 Elite', 'NXP LPC1768', 'Samsung Galaxy S25'].map(term => (
              <a
                href={`${BASE}/en/search/?q=${encodeURIComponent(term)}`}
                class="text-sm text-slate-400 hover:text-tp-cyan px-3 py-1.5 rounded-lg bg-navy-800 border border-tp-border hover:border-tp-cyan transition-colors"
              >
                {term}
              </a>
            ))}
          </div>
        </div>
      )}
    </div>

    <!-- Full-page search results with JS -->
    {q && (
      <div id="full-results" data-query={q}>
        <div class="animate-pulse space-y-3">
          {[1,2,3,4].map(() => (
            <div class="rounded-xl bg-navy-800/40 border border-tp-border p-4 flex gap-3">
              <div class="skeleton w-14 h-14 rounded-lg flex-shrink-0" />
              <div class="flex-1 space-y-2">
                <div class="skeleton h-4 w-2/3 rounded" />
                <div class="skeleton h-3 w-1/2 rounded" />
              </div>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</BaseLayout>

{q && (
  <script define:vars={{ query: q, BASE }}>
    async function loadResults() {
      const container = document.getElementById('full-results');
      if (!container) return;

      try {
        const { searchAll } = await import('/_astro/searchEngine.js').catch(() =>
          import(BASE + '/en/search/_searchEngine.js').catch(() => ({ searchAll: null }))
        );

        // Fallback: use dynamic import from module system
        const mod = await import('/en/search/').catch(() => null);

        // The search module is loaded via the SearchBar component's internal mechanism
        // For the full-page results we use a static approach
        const { searchAll: sa } = await (async () => {
          try {
            return await import('/src/engines/search/searchEngine.ts');
          } catch {
            return { searchAll: null };
          }
        })();

        if (!sa) {
          container.innerHTML = `<div class="text-center py-10 text-slate-400 text-sm">
            Use the search bar above to find results for "${query}"
          </div>`;
          return;
        }

        const results = await sa(query, { limit: 20 });
        if (!results.length) {
          container.innerHTML = `<div class="text-center py-10 text-slate-400">
            <div class="text-4xl mb-3">🔎</div>
            <p class="font-medium text-slate-300">No results found for "${query}"</p>
            <p class="text-sm mt-1">Try different keywords or browse by category.</p>
          </div>`;
          return;
        }

        const icons = { device: '📱', component: '🔌', brand: '🏢', technology: '💡', article: '📄', troubleshooting: '🔧' };
        const html = results.map(r => `
          <a href="${r.url}" class="flex items-start gap-4 p-4 rounded-xl bg-navy-800/40 border border-tp-border hover:border-slate-600 hover:bg-navy-700/50 transition-colors group">
            ${r.imageUrl
              ? `<img src="${r.imageUrl}" alt="${r.title}" class="w-14 h-14 rounded-lg object-contain bg-navy-900 flex-shrink-0" loading="lazy" onerror="this.style.display='none'" />`
              : `<div class="w-14 h-14 rounded-lg bg-navy-700 flex items-center justify-center text-2xl flex-shrink-0">${icons[r.type] ?? '🔍'}</div>`
            }
            <div class="min-w-0 flex-1">
              <div class="font-medium text-slate-100 group-hover:text-tp-cyan transition-colors">${r.title}</div>
              ${r.subtitle ? `<div class="text-sm text-slate-400 mt-0.5">${r.subtitle}</div>` : ''}
              ${r.description ? `<div class="text-sm text-slate-400 mt-1 line-clamp-2">${r.description}</div>` : ''}
            </div>
            <span class="tp-badge-blue text-xs flex-shrink-0">${r.type}</span>
          </a>
        `).join('');

        container.innerHTML = `<div class="space-y-3">
          <p class="text-sm text-slate-400 mb-4">${results.length} result${results.length !== 1 ? 's' : ''} for "${query}"</p>
          ${html}
        </div>`;
      } catch (e) {
        console.error('Search error:', e);
        container.innerHTML = `<div class="text-center py-10 text-slate-400 text-sm">
          Use the search bar above to find results for "${query}"
        </div>`;
      }
    }

    loadResults();
  </script>
)}
