---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getAllDevices, getDeviceBySlug, getRelatedDevices } from '../../../services/deviceService';
import { getBrandById } from '../../../services/brandService';
import DeviceCard from '../../../components/cards/DeviceCard';
import DeviceAutoImage from '../../../components/DeviceAutoImage';
import type { Device } from '../../../types';

export async function getStaticPaths() {
  const devices = getAllDevices();
  return devices.map(d => ({ params: { slug: d.slug } }));
}

const { slug } = Astro.params;
const BASE = '';

const device = getDeviceBySlug(slug!)!;
if (!device) return Astro.redirect(`${BASE}/en/devices/`);

const brand = getBrandById(device.brand);
const related = getRelatedDevices(device, 4);
const primaryImage = device.images?.[0];

function renderSpecs(specs: Record<string, unknown>, depth = 0): { key: string; label: string; value: string; group: string }[] {
  const rows: { key: string; label: string; value: string; group: string }[] = [];
  for (const [k, v] of Object.entries(specs ?? {})) {
    if (v === null || v === undefined) continue;
    if (typeof v === 'object' && !Array.isArray(v)) {
      const nested = renderSpecs(v as Record<string, unknown>, depth + 1);
      nested.forEach(r => {
        rows.push({ ...r, group: depth === 0 ? k : r.group });
      });
    } else {
      const label = k.replace(/([A-Z])/g, ' $1').replace(/^\w/, c => c.toUpperCase()).trim();
      const value = Array.isArray(v) ? v.join(', ') : String(v);
      rows.push({ key: k, label, value, group: depth === 0 ? k : '' });
    }
  }
  return rows;
}

const specRows = renderSpecs(device.specs as Record<string, unknown>);

const groups: Record<string, { key: string; label: string; value: string }[]> = {};
let currentGroup = 'General';
for (const row of specRows) {
  if (row.group) currentGroup = row.group;
  const gLabel = currentGroup.replace(/([A-Z])/g, ' $1').replace(/^\w/, c => c.toUpperCase()).trim();
  if (!groups[gLabel]) groups[gLabel] = [];
  if (row.key !== currentGroup) {
    groups[gLabel].push({ key: row.key, label: row.label, value: row.value });
  }
}

// Map device categories to related learn article slugs
const categoryLearnMap: Record<string, { slug: string; title: string; icon: string }[]> = {
  smartphone: [
    { slug: 'how-does-ram-work', title: 'How Does RAM Work?', icon: '💾' },
    { slug: 'gpu-architecture-basics', title: 'GPU Architecture Basics', icon: '🎮' },
    { slug: 'introduction-to-microcontrollers', title: 'SoC & Microcontrollers', icon: '🔧' },
  ],
  laptop: [
    { slug: 'what-is-a-cpu', title: 'What is a CPU?', icon: '⚙️' },
    { slug: 'how-does-ram-work', title: 'How Does RAM Work?', icon: '💾' },
    { slug: 'ssd-vs-hdd', title: 'SSD vs HDD Technology', icon: '💿' },
  ],
  tablet: [
    { slug: 'what-is-a-cpu', title: 'What is a CPU?', icon: '⚙️' },
    { slug: 'how-does-ram-work', title: 'How Does RAM Work?', icon: '💾' },
    { slug: 'wifi-7-explained', title: 'Wi-Fi 7 Explained', icon: '📶' },
  ],
  'gaming-console': [
    { slug: 'gpu-architecture-basics', title: 'GPU Architecture Basics', icon: '🎮' },
    { slug: 'ssd-vs-hdd', title: 'SSD vs HDD Technology', icon: '💿' },
    { slug: 'how-does-ram-work', title: 'How Does RAM Work?', icon: '💾' },
  ],
  'handheld-gaming': [
    { slug: 'gpu-architecture-basics', title: 'GPU Architecture Basics', icon: '🎮' },
    { slug: 'what-is-a-cpu', title: 'What is a CPU?', icon: '⚙️' },
    { slug: 'ssd-vs-hdd', title: 'SSD vs HDD Technology', icon: '💿' },
  ],
  monitor: [
    { slug: 'gpu-architecture-basics', title: 'GPU Architecture Basics', icon: '🎮' },
    { slug: 'wifi-7-explained', title: 'Wi-Fi 7 Explained', icon: '📶' },
  ],
  headphones: [
    { slug: 'wifi-7-explained', title: 'Bluetooth & Wireless Audio', icon: '📶' },
    { slug: 'understanding-transistors', title: 'Understanding Transistors', icon: '🔌' },
  ],
  tv: [
    { slug: 'gpu-architecture-basics', title: 'GPU & Display Tech', icon: '🎮' },
    { slug: 'wifi-7-explained', title: 'Wi-Fi 7 Explained', icon: '📶' },
  ],
};
const relatedLearn = categoryLearnMap[device.category] ?? [
  { slug: 'what-is-a-cpu', title: 'What is a CPU?', icon: '⚙️' },
  { slug: 'how-does-ram-work', title: 'How Does RAM Work?', icon: '💾' },
];

const categoryIcons: Record<string, string> = {
  smartphone: '📱', tablet: '📟', laptop: '💻', desktop: '🖥️',
  gpu: '🎮', monitor: '🖥️', smartwatch: '⌚', headphones: '🎧',
  router: '📡', storage: '💾', camera: '📷', tv: '📺',
  'gaming-console': '🎮', 'handheld-gaming': '🕹️',
};

const verificationBadge = {
  official: { label: 'Official Source', cls: 'tp-badge-green' },
  'multiple-sources': { label: 'Multiple Sources', cls: 'tp-badge-blue' },
  secondary: { label: 'Secondary Source', cls: 'tp-badge-amber' },
  unverified: { label: 'Unverified', cls: 'bg-slate-800/40 text-slate-400 border-slate-600/30 tp-badge' },
};
const vb = verificationBadge[device.verificationLevel] ?? verificationBadge.unverified;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: device.name,
  description: device.description,
  brand: { '@type': 'Brand', name: device.brandName },
  image: primaryImage?.url,
  url: `${BASE}/en/devices/${device.slug}/`,
};
---

<BaseLayout
  title={`${device.name} Specs & Review — Techpedia`}
  description={`${device.name} full specifications, features, images and comparison. ${device.description.slice(0, 100)}`}
  lang="en"
  ogImage={primaryImage?.url}
>
  <slot name="head" slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${BASE}/en/` },
        { '@type': 'ListItem', position: 2, name: 'Devices', item: `${BASE}/en/devices/` },
        { '@type': 'ListItem', position: 3, name: device.name, item: `${BASE}/en/devices/${device.slug}/` },
      ]
    })} />
  </slot>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-10">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-sm text-slate-400 mb-6 flex-wrap">
      <a href={`${BASE}/en/`} class="hover:text-slate-200 transition-colors">Home</a>
      <span class="text-slate-600">/</span>
      <a href={`${BASE}/en/devices/`} class="hover:text-slate-200 transition-colors">Devices</a>
      <span class="text-slate-600">/</span>
      <a href={`${BASE}/en/devices/?category=${device.category}`} class="hover:text-slate-200 transition-colors capitalize">{device.category}</a>
      <span class="text-slate-600">/</span>
      <span class="text-slate-200 truncate">{device.name}</span>
    </nav>

    <div class="grid lg:grid-cols-[320px_1fr] gap-10">
      <!-- Left column: image & quick info -->
      <div class="lg:sticky lg:top-20 self-start">
        <!-- Product image — auto-fetches from Wikipedia if no local image -->
        <div class="rounded-2xl overflow-hidden border border-slate-700/50 bg-gradient-to-br from-slate-800/60 to-slate-900/60 mb-4 aspect-square flex items-center justify-center relative group/img">
          <DeviceAutoImage
            deviceName={device.name}
            fallbackIcon={categoryIcons[device.category] ?? '📦'}
            className="w-full h-full"
            priority={true}
            client:visible
          />
          <div class="absolute inset-0 ring-1 ring-inset ring-white/5 rounded-2xl pointer-events-none" />
        </div>

        <!-- Quick actions -->
        <div class="flex gap-2 mb-4">
          <a
            href={`${BASE}/en/compare/?ids=${device.id}`}
            class="tp-btn-secondary flex-1 justify-center text-sm"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2"/>
            </svg>
            Compare
          </a>
          <button class="tp-btn-secondary text-sm" onclick="navigator.share?.({title: document.title, url: location.href}) || navigator.clipboard?.writeText(location.href)">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/>
            </svg>
            Share
          </button>
        </div>

        <!-- Status & verification -->
        <div class="rounded-xl bg-navy-800/40 border border-tp-border p-4 space-y-3">
          <div class="flex justify-between items-center">
            <span class="text-xs text-slate-400">Status</span>
            <span class={`text-xs px-2 py-0.5 rounded border font-medium ${
              device.status === 'available' ? 'bg-emerald-900/40 text-emerald-400 border-emerald-700/30' :
              device.status === 'discontinued' ? 'bg-slate-800/60 text-slate-400 border-slate-600/30' :
              'bg-amber-900/40 text-amber-400 border-amber-700/30'
            }`}>{device.status}</span>
          </div>
          {device.releasedAt && (
            <div class="flex justify-between items-center">
              <span class="text-xs text-slate-400">Released</span>
              <span class="text-xs text-slate-200">{new Date(device.releasedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
            </div>
          )}
          <div class="flex justify-between items-center">
            <span class="text-xs text-slate-400">Data quality</span>
            <span class={`text-xs px-2 py-0.5 rounded border font-medium ${vb.cls}`}>{vb.label}</span>
          </div>
          <div class="flex justify-between items-center">
            <span class="text-xs text-slate-400">Updated</span>
            <span class="text-xs text-slate-400">{new Date(device.updatedAt).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}</span>
          </div>
        </div>

        <!-- Where to Buy -->
        {device.affiliateLinks && device.affiliateLinks.length > 0 && (
          <div class="mt-4 rounded-xl bg-navy-800/40 border border-tp-border p-4">
            <h4 class="text-xs font-semibold text-slate-300 mb-3 uppercase tracking-wider">Where to Buy</h4>
            <div class="space-y-2">
              {device.affiliateLinks.map((link: { provider: string; url: string; label?: string; country?: string; type?: string }) => (
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer sponsored"
                  class="flex items-center justify-between gap-2 px-3 py-2 rounded-lg bg-tp-blue/10 border border-tp-blue/20 hover:bg-tp-blue/20 transition-colors group"
                >
                  <span class="text-sm font-medium text-slate-200 group-hover:text-tp-blue transition-colors truncate">{link.label ?? link.provider}</span>
                  <div class="flex items-center gap-1 flex-shrink-0">
                    {link.country && <span class="text-xs text-slate-500">{link.country}</span>}
                    <svg class="w-3.5 h-3.5 text-tp-cyan" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6m0 0v6m0-6L10 14"/>
                    </svg>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- Sources -->
        {device.sources.length > 0 && (
          <div class="mt-4 rounded-xl bg-navy-800/40 border border-tp-border p-4">
            <h4 class="text-xs font-semibold text-slate-300 mb-2 uppercase tracking-wider">Sources</h4>
            <ul class="space-y-1.5">
              {device.sources.map(s => (
                <li>
                  <a
                    href={s.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-xs text-tp-blue hover:text-tp-blue-bright transition-colors flex items-center gap-1"
                  >
                    <svg class="w-3 h-3 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6m0 0v6m0-6L10 14"/>
                    </svg>
                    {s.provider}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>

      <!-- Right column: main content -->
      <div class="min-w-0">
        <!-- Product header -->
        <div class="mb-8">
          <div class="flex items-center gap-2 mb-2">
            {brand && (
              <a href={`${BASE}/en/brands/${brand.slug}/`} class="text-sm text-tp-blue hover:text-tp-blue-bright font-medium">
                {brand.name}
              </a>
            )}
            <span class="text-slate-600">·</span>
            <span class="tp-badge-cyan capitalize">{device.category}</span>
          </div>
          <h1 class="text-3xl sm:text-4xl font-bold text-slate-100 mb-3">{device.name}</h1>
          <p class="text-slate-400 leading-relaxed max-w-3xl">{device.description}</p>
        </div>

        <!-- Key features -->
        {device.keyFeatures.length > 0 && (
          <div class="mb-8">
            <h2 class="text-lg font-semibold text-slate-100 mb-3">Key Features</h2>
            <div class="flex flex-wrap gap-2">
              {device.keyFeatures.map(f => (
                <span class="text-sm px-3 py-1 rounded-lg bg-navy-800 border border-tp-border text-slate-300">
                  {f}
                </span>
              ))}
            </div>
          </div>
        )}

        <!-- Technical specifications -->
        <div class="mb-8">
          <h2 class="text-lg font-semibold text-slate-100 mb-4">Technical Specifications</h2>
          <div class="rounded-xl border border-tp-border overflow-hidden">
            {Object.entries(groups).map(([groupName, rows], gi) => (
              <div>
                <div class="bg-navy-700/50 px-4 py-2 border-b border-tp-border">
                  <span class="text-xs font-semibold text-tp-cyan uppercase tracking-wider">{groupName}</span>
                </div>
                <div class="divide-y divide-tp-border/50">
                  {rows.map((row, ri) => (
                    <div class={`flex items-start px-4 py-2.5 ${ri % 2 === 0 ? 'bg-navy-900/30' : 'bg-navy-800/20'}`}>
                      <span class="spec-label">{row.label}</span>
                      <span class="spec-value">{row.value}</span>
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Variants -->
        {device.variants.length > 0 && (
          <div class="mb-8">
            <h2 class="text-lg font-semibold text-slate-100 mb-3">Available Variants</h2>
            <div class="grid gap-2 sm:grid-cols-2">
              {device.variants.map(v => (
                <div class="rounded-lg bg-navy-800/40 border border-tp-border p-3">
                  <div class="text-sm font-medium text-slate-200">{v.name}</div>
                  {v.region && <div class="text-xs text-slate-400 mt-0.5">Region: {v.region}</div>}
                  {v.storageOptions && <div class="text-xs text-slate-400">Storage: {v.storageOptions.join(' / ')}</div>}
                  {v.ramOptions && <div class="text-xs text-slate-400">RAM: {v.ramOptions.join(' / ')}</div>}
                </div>
              ))}
            </div>
          </div>
        )}

        <!-- Tags -->
        {device.tags.length > 0 && (
          <div class="mb-8">
            <div class="flex flex-wrap gap-1.5">
              {device.tags.map(tag => (
                <a
                  href={`${BASE}/en/search/?q=${encodeURIComponent(tag)}`}
                  class="text-xs px-2 py-0.5 rounded bg-navy-800 border border-tp-border text-slate-500 hover:text-slate-300 hover:border-slate-500 transition-colors"
                >
                  #{tag}
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>

    <!-- Related devices -->
    {related.length > 0 && (
      <div class="mt-16">
        <h2 class="text-xl font-semibold text-slate-100 mb-5">Related Devices</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {related.map(r => (
            <DeviceCard device={r} lang="en" client:visible />
          ))}
        </div>
      </div>
    )}

    <!-- Related Learn articles -->
    {relatedLearn.length > 0 && (
      <div class="mt-12 pt-8 border-t border-tp-border">
        <div class="flex items-center gap-2 mb-5">
          <span class="text-lg">📚</span>
          <h2 class="text-lg font-semibold text-slate-100">Learn More</h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {relatedLearn.map(article => (
            <a href={`${BASE}/en/learn/${article.slug}/`} class="tp-card p-4 flex items-center gap-3 hover:border-tp-blue/50 transition-colors group">
              <div class="w-9 h-9 rounded-lg bg-navy-700 flex items-center justify-center text-xl flex-shrink-0">{article.icon}</div>
              <span class="text-sm font-medium text-slate-300 group-hover:text-tp-blue transition-colors leading-snug">{article.title}</span>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</BaseLayout>
