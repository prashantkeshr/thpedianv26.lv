---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DeviceCard from '../../../components/cards/DeviceCard';
import { getAllDevices, getAllCategories } from '../../../services/deviceService';

const BASE = '';
const devices = getAllDevices();
const categories = getAllCategories();

const categoryLabel: Record<string, string> = {
  smartphone: 'Smartphones', laptop: 'Laptops', desktop: 'Desktops',
  tablet: 'Tablets', monitor: 'Monitors', tv: 'TVs',
  gpu: 'GPUs', router: 'Routers', storage: 'Storage', other: 'Other',
};

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Device Encyclopedia — Techpedia',
  description: 'Complete device specification database including smartphones, laptops, CPUs, GPUs and more.',
  url: `${import.meta.env.SITE ?? 'https://prashantkeshr.github.io'}/thpedianv26.lv/en/devices/`,
};
---

<BaseLayout
  title="Device Encyclopedia — Techpedia"
  description="Browse all devices in the Techpedia database. Detailed specifications for smartphones, laptops, tablets, GPUs and more."
  lang="en"
>
  <slot name="head" slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${BASE}/en/` },
        { '@type': 'ListItem', position: 2, name: 'Devices', item: `${BASE}/en/devices/` },
      ]
    })} />
  </slot>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-10">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-sm text-slate-400 mb-6">
      <a href={`${BASE}/en/`} class="hover:text-slate-200 transition-colors">Home</a>
      <span class="text-slate-600">/</span>
      <span class="text-slate-200">Devices</span>
    </nav>

    <!-- Header -->
    <div class="mb-10">
      <h1 class="text-3xl font-bold text-slate-100 mb-2">Device Encyclopedia</h1>
      <p class="text-slate-400">{devices.length} devices with verified technical specifications</p>
    </div>

    <!-- Category filters -->
    <div class="flex flex-wrap gap-2 mb-8">
      <a
        href={`${BASE}/en/devices/`}
        class="tp-btn-secondary text-sm px-3 py-1.5"
      >
        All ({devices.length})
      </a>
      {categories.map(cat => (
        <a
          href={`${BASE}/en/devices/?category=${cat}`}
          class="tp-btn-ghost text-sm px-3 py-1.5"
        >
          {categoryLabel[cat] ?? cat} ({devices.filter(d => d.category === cat).length})
        </a>
      ))}
    </div>

    <!-- Device grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
      {devices.map(device => (
        <DeviceCard device={device} lang="en" client:visible />
      ))}
    </div>

    {devices.length === 0 && (
      <div class="text-center py-20 text-slate-400">
        <div class="text-5xl mb-4">📭</div>
        <p class="text-lg font-medium">No devices found</p>
        <p class="text-sm mt-1">More devices are being added continuously.</p>
      </div>
    )}
  </div>
</BaseLayout>
