---
import BaseLayout from '../../../layouts/BaseLayout.astro';
const BASE = '/thpedianv26.lv';

const technologies = [
  { name: 'USB Standards', slug: 'usb-standards', category: 'Interface', icon: '🔌', desc: 'USB 2.0, 3.x, 4.0 and USB-C evolution — speeds, power delivery and compatibility.' },
  { name: 'Wi-Fi Generations', slug: 'wifi-generations', category: 'Wireless', icon: '📶', desc: '802.11 standards from 802.11a to Wi-Fi 7 (802.11be), speeds, bands and features.' },
  { name: 'Display Technologies', slug: 'display-technologies', category: 'Display', icon: '🖥️', desc: 'LCD, IPS, OLED, AMOLED, Mini-LED, Micro-LED and emerging display technologies.' },
  { name: 'Semiconductor Nodes', slug: 'semiconductor-nodes', category: 'Semiconductor', icon: '⚙️', desc: 'TSMC, Samsung and Intel process nodes from 10nm to 2nm and beyond.' },
  { name: 'RAM Technologies', slug: 'ram-technologies', category: 'Memory', icon: '💾', desc: 'DDR4, DDR5, LPDDR5X — speeds, timing, bandwidth and platform compatibility.' },
  { name: 'Bluetooth Standards', slug: 'bluetooth-standards', category: 'Wireless', icon: '📡', desc: 'Bluetooth Classic, BLE, Bluetooth 5.x, 6.0 — range, throughput, audio codecs.' },
  { name: 'NVMe and Storage', slug: 'nvme-storage', category: 'Storage', icon: '💽', desc: 'SATA vs NVMe, PCIe 4.0/5.0 drives, NAND types, TLC vs QLC and enterprise storage.' },
  { name: '5G and Cellular', slug: '5g-cellular', category: 'Cellular', icon: '📱', desc: 'From 2G to 5G NR — sub-6 GHz vs mmWave, massive MIMO, network slicing and 5G-Advanced.' },
  { name: 'Cooling Technologies', slug: 'cooling-technologies', category: 'Thermal', icon: '❄️', desc: 'Air coolers, AIO liquid, vapour chambers, heat pipes and mobile thermal solutions.' },
  { name: 'GPU APIs and Standards', slug: 'gpu-apis', category: 'Graphics', icon: '🎮', desc: 'DirectX 12, Vulkan, Metal, OpenGL and WebGPU — when to use each and what changed.' },
];
---

<BaseLayout
  title="Technology Explorer — Techpedia"
  description="Explore technology timelines, standards and comparisons: Wi-Fi, USB, display technologies, semiconductor nodes and more."
  lang="en"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-10">
    <nav class="flex items-center gap-2 text-sm text-slate-400 mb-6">
      <a href={`${BASE}/en/`} class="hover:text-slate-200">Home</a>
      <span>/</span>
      <span class="text-slate-200">Technologies</span>
    </nav>

    <div class="mb-10">
      <h1 class="text-3xl font-bold text-slate-100 mb-2">Technology Explorer</h1>
      <p class="text-slate-400">Standards, generations, timelines and deep technical explanations</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {technologies.map(tech => (
        <a href={`${BASE}/en/technologies/${tech.slug}/`} class="tp-card p-5 flex flex-col gap-3 hover:border-tp-blue/40 transition-colors group">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg bg-navy-700 flex items-center justify-center text-xl">{tech.icon}</div>
            <div>
              <h3 class="font-semibold text-slate-100 group-hover:text-tp-blue transition-colors">{tech.name}</h3>
              <span class="tp-badge-blue text-xs">{tech.category}</span>
            </div>
          </div>
          <p class="text-sm text-slate-400">{tech.desc}</p>
          <div class="mt-auto">
            <span class="text-xs text-tp-cyan group-hover:underline">Read deep dive →</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
