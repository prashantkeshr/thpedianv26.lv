---
import BaseLayout from '../../../layouts/BaseLayout.astro';
const BASE = '/thpedianv26.lv';

const guides = [
  { slug: 'laptop-overheating', title: 'Laptop Overheating', category: 'laptop', icon: '🌡️', steps: 7, symptoms: 'Thermal throttling, fan noise, unexpected shutdown during load.' },
  { slug: 'smartphone-battery-drain', title: 'Smartphone Battery Drain', category: 'smartphone', icon: '🔋', steps: 7, symptoms: 'Battery depletes unusually fast, phone warm at idle, dies above 10%.' },
  { slug: 'pc-wont-boot', title: "PC Won't Boot", category: 'desktop', icon: '🖥️', steps: 7, symptoms: 'No POST, blank screen on startup, beep codes, Windows boot loop.' },
  { slug: 'wifi-disconnecting', title: 'Wi-Fi Disconnecting', category: 'networking', icon: '📶', steps: 7, symptoms: 'Intermittent drops, shows connected but no internet, slow speeds.' },
  { slug: 'monitor-flickering', title: 'Monitor Flickering', category: 'monitor', icon: '🖱️', steps: 7, symptoms: 'Screen flicker, brightness-dependent flicker, black flash, banding.' },
  { slug: 'printer-not-printing', title: 'Printer Not Printing', category: 'printer', icon: '🖨️', steps: 7, symptoms: 'Offline status, stuck print queue, blank pages, colour streaks.' },
];
---

<BaseLayout
  title="Troubleshooting Guides — Techpedia"
  description="Interactive troubleshooting guides for smartphones, laptops, PCs, circuits and components. Step-by-step diagnostic trees."
  lang="en"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-10">
    <nav class="flex items-center gap-2 text-sm text-slate-400 mb-6">
      <a href={`${BASE}/en/`} class="hover:text-slate-200">Home</a>
      <span>/</span>
      <span class="text-slate-200">Troubleshoot</span>
    </nav>

    <div class="mb-10">
      <h1 class="text-3xl font-bold text-slate-100 mb-2">Troubleshooting Centre</h1>
      <p class="text-slate-400">Step-by-step diagnostic guides for common technology problems</p>
    </div>

    <div class="rounded-xl bg-amber-900/20 border border-amber-700/30 p-4 mb-8 flex items-start gap-3">
      <span class="text-xl flex-shrink-0">⚠️</span>
      <div class="text-sm text-amber-300">
        <strong class="text-amber-200">Safety first:</strong> Some repairs involve high voltage, lasers or sharp components.
        When in doubt, consult a qualified repair professional. These guides are for general diagnostic assistance only.
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {guides.map(guide => (
        <a href={`${BASE}/en/troubleshoot/${guide.slug}/`} class="tp-card p-5 flex flex-col gap-3 hover:border-amber-700/50 transition-colors">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg bg-amber-900/40 border border-amber-700/30 flex items-center justify-center text-xl">{guide.icon}</div>
            <div>
              <h3 class="font-semibold text-slate-100">{guide.title}</h3>
              <div class="flex items-center gap-2 mt-0.5">
                <span class="tp-badge-amber text-xs capitalize">{guide.category}</span>
                <span class="text-xs text-slate-500">· {guide.steps} steps</span>
              </div>
            </div>
          </div>
          <p class="text-sm text-slate-400">{guide.symptoms}</p>
          <div class="mt-auto">
            <span class="text-xs text-amber-400 font-medium">View guide →</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
